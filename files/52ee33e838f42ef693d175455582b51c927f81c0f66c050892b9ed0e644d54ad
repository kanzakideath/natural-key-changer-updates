<!doctype html>
<html>
<head>
<meta charset="utf-8">
<title data-i18n="appShort">Key Changer</title>
<link rel="stylesheet" href="popup.css">
</head>
<body class="is-off tab-key">
<div class="app">
	<header class="top">
		<h1 id="viewTitle" data-i18n="titleKey">Key Changer</h1>
		<div class="top-actions">
			<button id="openSheet" class="icon-btn" type="button" data-i18n-aria="settings" data-i18n-title="settings">
				<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z" /></svg>
			</button>
			<label class="switch" data-i18n-title="powerLabel">
				<input type="checkbox" id="power" role="switch" data-i18n-aria="powerLabel">
				<span class="switch-track"><span class="switch-thumb"></span></span>
			</label>
		</div>
	</header>

	<div class="views">
		<div class="views-track">
			<!-- ===== key tab ===== -->
			<div class="view" id="viewKey">
				<div class="hero-slot">
					<button id="powerBig" class="power-big" type="button">
						<span class="power-icon" aria-hidden="true">
							<svg viewBox="0 0 24 24"><path d="M12 3v8" /><path d="M6.4 6.8a8 8 0 1 0 11.2 0" /></svg>
						</span>
						<span class="power-text">
							<span class="power-title" data-i18n="turnOn"></span>
							<span class="power-sub" id="powerSub"></span>
						</span>
					</button>
					<div class="status" id="statusBar" aria-live="polite">
						<span class="chip"><span class="chip-label" data-i18n="chipMode"></span><span class="chip-value"><span class="dot live" id="modeDot"></span><span id="modeLabel"></span></span></span>
						<span class="chip"><span class="chip-label" data-i18n="chipDelay"></span><span class="chip-value num" id="latency">–</span></span>
						<span class="chip"><span class="chip-label" data-i18n="chipLoad"></span><span class="chip-value"><span class="dot" id="loadDot"></span><span id="loadLabel">–</span></span></span>
					</div>
				</div>

				<section class="card key-card">
					<div class="key-head">
						<span class="label" data-i18n="key"></span>
						<button id="keyReset" class="pill-btn" type="button" data-i18n="keyReset"></button>
					</div>
					<div class="key-row">
						<button id="keyDown" class="round-btn" type="button" data-i18n-aria="keyDown">
							<svg viewBox="0 0 24 24"><path d="M6 12h12" /></svg>
						</button>
						<div class="key-display" aria-live="polite">
							<div class="key-roller" id="keyRoller"><span class="key-num">0</span></div>
							<span class="key-unit" id="keyUnit" data-i18n="semitones" aria-live="polite"></span>
						</div>
						<button id="keyUp" class="round-btn" type="button" data-i18n-aria="keyUp">
							<svg viewBox="0 0 24 24"><path d="M6 12h12" /><path d="M12 6v12" /></svg>
						</button>
					</div>
					<input id="key" class="ios-range" type="range" min="-12" max="12" step="1" value="0" data-i18n-aria="key">
					<div class="ticks"><span>−12</span><span>0</span><span>+12</span></div>
				</section>

				<button id="bypass" class="ab" type="button" aria-pressed="false">
					<span class="ab-icon" aria-hidden="true">
						<svg viewBox="0 0 24 24"><path d="M3 12h3l3-7 4 14 3-7h5" /></svg>
					</span>
					<span class="ab-text">
						<span class="ab-title" id="abTitle"></span>
						<span class="ab-sub" id="abSub"></span>
					</span>
				</button>

				<section class="card mode-card">
					<div class="segmented" role="radiogroup" data-i18n-aria="chipMode">
						<span class="seg-thumb" id="segThumb"></span>
						<button type="button" role="radio" data-mode="light" data-i18n="modeLight"></button>
						<button type="button" role="radio" data-mode="hq" data-i18n="modeHq"></button>
					</div>
					<p class="mode-hint" id="modeHint"></p>
					<p class="mode-notice" id="notice" hidden>
						<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 8v5" /><path d="M12 16.5v.5" /><circle cx="12" cy="12" r="9" /></svg>
						<span id="noticeText"></span>
					</p>
				</section>
			</div>

			<!-- ===== practice tab ===== -->
			<div class="view" id="viewPractice">
				<section class="card vocal-card">
					<div class="card-head">
						<span class="label" data-i18n="vocal"></span>
						<span class="value" id="vocalValue">100%</span>
					</div>
					<input id="vocal" class="ios-range" type="range" min="0" max="100" step="5" value="100" data-i18n-aria="vocal">
					<div class="chips-row">
						<button type="button" class="choice" data-vocal="0" data-i18n="choiceKaraoke"></button>
						<button type="button" class="choice" data-vocal="30" data-i18n="choiceGuide"></button>
						<button type="button" class="choice" data-vocal="100" data-i18n="choiceFull"></button>
					</div>
					<div class="locked" id="vocalLocked">
						<span data-i18n="lockedText"></span>
						<button id="toHq" class="pill-btn strong" type="button" data-i18n="toHq"></button>
					</div>
				</section>

				<section class="card range-card">
					<div class="card-head">
						<span class="label" data-i18n="rangeTitle"></span>
						<span class="sub" id="measureState"></span>
					</div>
					<div class="range-graph" aria-hidden="true">
						<div class="bar song" id="barSong"></div>
						<div class="bar voice" id="barVoice"></div>
					</div>
					<div class="range-rows">
						<div class="range-row"><span class="legend song"></span><span class="who" data-i18n="thisSong"></span><span class="notes" id="songRange">–</span></div>
						<div class="range-row"><span class="legend voice"></span><span class="who" data-i18n="you"></span><span class="notes" id="voiceRange"></span>
							<button id="editVoice" class="link-btn" type="button"></button></div>
					</div>
					<div class="recommend" id="recommend">
						<span class="rec-text" id="recText"></span>
						<button id="applyRec" class="pill-btn strong" type="button" hidden data-i18n="applyRec"></button>
					</div>
				</section>

				<section class="card loop-card">
					<div class="card-head">
						<span class="label" data-i18n="loopTitle"></span>
						<label class="switch small" data-i18n-title="loopTitle">
							<input type="checkbox" id="loopOn" role="switch" data-i18n-aria="loopTitle">
							<span class="switch-track"><span class="switch-thumb"></span></span>
						</label>
					</div>
					<div class="loop-row">
						<button id="loopA" class="loop-btn" type="button"><b>A</b><span id="loopAText"></span></button>
						<svg class="loop-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14" /><path d="M13 6l6 6-6 6" /></svg>
						<button id="loopB" class="loop-btn" type="button"><b>B</b><span id="loopBText"></span></button>
						<button id="loopClear" class="icon-btn small" type="button" data-i18n-aria="loopClear">
							<svg viewBox="0 0 24 24"><path d="M6 6l12 12" /><path d="M18 6L6 18" /></svg>
						</button>
					</div>
				</section>

				<button id="openSongs" class="row-btn" type="button">
					<span><span data-i18n="keyBook"></span><small data-i18n="keyBookSub"></small></span>
					<span class="row-value" id="songCount"></span>
					<svg class="chev" viewBox="0 0 24 24"><path d="M9 6l6 6-6 6" /></svg>
				</button>
			</div>
		</div>
	</div>

	<nav class="tabbar" role="tablist">
		<button type="button" role="tab" class="tab" data-tab="key" aria-selected="true">
			<svg viewBox="0 0 24 24"><path d="M9 18V5l11-2v13" /><circle cx="6" cy="18" r="3" /><circle cx="17" cy="16" r="3" /></svg>
			<span data-i18n="tabKey"></span>
		</button>
		<button type="button" role="tab" class="tab" data-tab="practice" aria-selected="false">
			<svg viewBox="0 0 24 24"><rect x="9" y="2" width="6" height="12" rx="3" /><path d="M5 10a7 7 0 0 0 14 0" /><path d="M12 17v4" /><path d="M8 21h8" /></svg>
			<span data-i18n="tabPractice"></span>
		</button>
		<span class="tab-indicator" id="tabIndicator"></span>
	</nav>
</div>

<div class="backdrop" id="backdrop"></div>

<section class="sheet" id="sheet" role="dialog" aria-modal="true" aria-labelledby="sheetTitle" inert>
	<div class="grabber"><span></span></div>
	<div class="sheet-head">
		<h2 id="sheetTitle" data-i18n="settings"></h2>
		<button class="done-btn" type="button" data-close data-i18n="done"></button>
	</div>
	<div class="sheet-body">
		<p class="group-title" data-i18n="formantTitle"></p>
		<div class="group">
			<div class="group-row column">
				<div class="formant-head">
					<span class="formant-value" id="formantValue"></span>
					<button id="formantReset" class="pill-btn" type="button" data-i18n="formantKeep"></button>
				</div>
				<input id="formant" class="ios-range" type="range" min="-3" max="3" step="0.5" value="0" data-i18n-aria="formantTitle">
				<div class="ticks"><span data-i18n="formantThin"></span><span data-i18n="formantThick"></span></div>
			</div>
		</div>
		<p class="group-foot" data-i18n="formantFoot"></p>

		<p class="group-title" data-i18n="videoTitle"></p>
		<div class="group">
			<label class="group-row">
				<span data-i18n="videoSync"></span>
				<span class="switch small">
					<input type="checkbox" id="videoSync" role="switch">
					<span class="switch-track"><span class="switch-thumb"></span></span>
				</span>
			</label>
		</div>

		<p class="group-title" data-i18n="lyricsTitle"></p>
		<div class="group">
			<label class="group-row">
				<span data-i18n="lyricsShow"></span>
				<span class="switch small">
					<input type="checkbox" id="lyricsOn" role="switch">
					<span class="switch-track"><span class="switch-thumb"></span></span>
				</span>
			</label>
			<label class="group-row">
				<span data-i18n="lyricsAi"></span>
				<span class="switch small">
					<input type="checkbox" id="lyricsAi" role="switch">
					<span class="switch-track"><span class="switch-thumb"></span></span>
				</span>
			</label>
			<label class="group-row">
				<span data-i18n="lyricsHeard"></span>
				<span class="switch small">
					<input type="checkbox" id="lyricsHeard" role="switch">
					<span class="switch-track"><span class="switch-thumb"></span></span>
				</span>
			</label>
		</div>
		<p class="group-foot" data-i18n="lyricsFoot"></p>

		<p class="group-title" data-i18n="engineTitle"></p>
		<div class="group" id="engineList" role="radiogroup" data-i18n-aria="engineTitle"></div>
		<p class="group-foot" data-i18n="engineFoot"></p>

		<p class="group-title" data-i18n="updSection"></p>
		<div class="group">
			<label class="group-row">
				<span data-i18n="updAutoShort"></span>
				<span class="switch small">
					<input type="checkbox" id="autoUpdate" role="switch">
					<span class="switch-track"><span class="switch-thumb"></span></span>
				</span>
			</label>
			<div class="group-row" id="openUpdate" role="button" tabindex="0" style="cursor:pointer">
				<span id="updRow"></span>
				<span aria-hidden="true" style="opacity:.4">&rsaquo;</span>
			</div>
		</div>

		<p class="group-title" data-i18n="shortcutsTitle"></p>
		<div class="group shortcuts">
			<div class="group-row"><span data-i18n="scKey"></span><kbd id="scKey">Alt+Shift+↑ / ↓</kbd></div>
			<div class="group-row"><span data-i18n="scBypass"></span><kbd id="scBypass">Alt+Shift+O</kbd></div>
			<div class="group-row"><span data-i18n="scOpen"></span><kbd id="scOpen">Alt+Shift+K</kbd></div>
			<button id="scChange" class="group-row engine-row" type="button"><span data-i18n="scChange"></span><svg class="chev" viewBox="0 0 24 24"><path d="M9 6l6 6-6 6" /></svg></button>
		</div>
	</div>
</section>

<section class="sheet" id="songsSheet" role="dialog" aria-modal="true" aria-labelledby="songsTitle" inert>
	<div class="grabber"><span></span></div>
	<div class="sheet-head">
		<h2 id="songsTitle" data-i18n="keyBook"></h2>
		<button class="done-btn" type="button" data-close data-i18n="done"></button>
	</div>
	<div class="sheet-body">
		<div class="group">
			<label class="group-row">
				<span data-i18n="keyBookAuto"></span>
				<span class="switch small">
					<input type="checkbox" id="autoKey" role="switch">
					<span class="switch-track"><span class="switch-thumb"></span></span>
				</span>
			</label>
		</div>
		<p class="group-foot" data-i18n="keyBookFoot"></p>
		<p class="group-title" data-i18n="savedSongs"></p>
		<div class="group" id="songList"></div>
		<p class="empty" id="songEmpty" data-i18n="keyBookEmpty"></p>
	</div>
</section>

<script type="module" src="popup.js"></script>
</body>
</html>
