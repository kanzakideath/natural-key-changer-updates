/* iOS-style popup. Must stay within Chrome's 600px popup height limit. */
:root {
	--bg: #f2f2f7;
	--card: #ffffff;
	--card-2: #f2f2f7;
	--fill: rgba(118, 118, 128, 0.12);
	--fill-2: rgba(118, 118, 128, 0.2);
	--sep: rgba(60, 60, 67, 0.18);
	--text: #000000;
	--text-2: rgba(60, 60, 67, 0.6);
	--text-3: rgba(60, 60, 67, 0.3);
	--tint: #5856d6;
	--tint-soft: rgba(88, 86, 214, 0.12);
	--on: #34c759;
	--orange: #ff9500;
	--red: #ff3b30;
	--thumb-shadow: 0 3px 8px rgba(0, 0, 0, 0.15), 0 3px 1px rgba(0, 0, 0, 0.06), 0 0 0 0.5px rgba(0, 0, 0, 0.04);
	--card-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
	--sheet-bg: #f2f2f7;
	--spring: cubic-bezier(0.34, 1.56, 0.64, 1);
	--ease: cubic-bezier(0.32, 0.72, 0, 1);
	color-scheme: light;
}
@media (prefers-color-scheme: dark) {
	:root {
		--bg: #000000;
		--card: #1c1c1e;
		--card-2: #2c2c2e;
		--fill: rgba(118, 118, 128, 0.24);
		--fill-2: rgba(118, 118, 128, 0.36);
		--sep: rgba(84, 84, 88, 0.6);
		--text: #ffffff;
		--text-2: rgba(235, 235, 245, 0.6);
		--text-3: rgba(235, 235, 245, 0.3);
		--tint: #7d7aff;
		--tint-soft: rgba(125, 122, 255, 0.18);
		--on: #30d158;
		--orange: #ff9f0a;
		--red: #ff453a;
		--card-shadow: none;
		--sheet-bg: #1c1c1e;
		color-scheme: dark;
	}
	.sheet .group { background: #2c2c2e; }
}

* { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
html, body { margin: 0; }
body {
	width: 360px;
	height: 584px;
	text-wrap: pretty;
	overflow: hidden;
	background: var(--bg);
	color: var(--text);
	font: 14px/1.45 -apple-system, BlinkMacSystemFont, "Hiragino Sans", "Hiragino Kaku Gothic ProN", "Yu Gothic UI", "Meiryo UI", "Noto Sans JP", "Noto Sans CJK JP", system-ui, sans-serif;
	-webkit-font-smoothing: antialiased;
	user-select: none;
}
button { font: inherit; color: inherit; border: 0; background: none; padding: 0; cursor: pointer; }
svg { fill: none; stroke: currentColor; stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }
:focus-visible { outline: 3px solid var(--tint-soft); outline-offset: 2px; border-radius: 12px; }

.app { height: 100%; display: flex; flex-direction: column; }
.top { padding: 10px 14px 0; flex: none; }
.top-actions { display: flex; align-items: center; gap: 10px; }
.icon-btn { width: 34px; height: 34px; border-radius: 17px; display: grid; place-items: center; color: var(--tint); background: var(--fill); transition: transform 0.35s var(--spring), background-color 0.2s; }
.icon-btn:active { transform: scale(0.9); transition-duration: 0.08s; }
.icon-btn svg { width: 19px; height: 19px; stroke-width: 2; }
.icon-btn.small { width: 30px; height: 30px; color: var(--text-2); }
.icon-btn.small svg { width: 15px; height: 15px; stroke-width: 2.6; }
.views { flex: 1; overflow: hidden; position: relative; }
.views-track { display: flex; width: 200%; height: 100%; transition: transform 0.55s var(--ease); }
.view { width: 50%; height: 100%; padding: 8px 14px 6px; display: flex; flex-direction: column; gap: 10px; overflow: hidden; transition: opacity 0.4s var(--ease); }
body.tab-practice .views-track { transform: translateX(-50%); }
body.tab-key #viewPractice, body.tab-practice #viewKey { opacity: 0.3; }

/* tab bar */
.tabbar {
	flex: none; position: relative; display: grid; grid-template-columns: 1fr 1fr; height: 54px;
	border-top: 0.5px solid var(--sep); background: color-mix(in srgb, var(--bg) 85%, transparent); backdrop-filter: blur(20px);
}
.tab { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px; font-size: 11px; color: var(--text-2); transition: color 0.25s; }
.tab svg { width: 22px; height: 22px; stroke-width: 1.9; transition: transform 0.45s var(--spring); }
.tab[aria-selected="true"] { color: var(--tint); }
.tab[aria-selected="true"] svg { transform: translateY(-1px) scale(1.08); }
.tab:active svg { transform: scale(0.85); transition-duration: 0.08s; }
.tab-indicator { position: absolute; top: -0.5px; left: 0; width: 50%; height: 2px; display: flex; justify-content: center; transition: transform 0.5s var(--spring); pointer-events: none; }
.tab-indicator::after { content: ""; width: 36px; height: 2px; border-radius: 2px; background: var(--tint); }
body.tab-practice .tab-indicator { transform: translateX(100%); }

/* pressable feel */
.round-btn, .ab, .row-btn, .power-big, .pill-btn, .done-btn, .segmented button {
	transition: transform 0.35s var(--spring), background-color 0.25s, opacity 0.25s, color 0.25s;
}
.round-btn:active, .ab:active, .row-btn:active, .power-big:active, .pill-btn:active { transform: scale(0.94); transition-duration: 0.08s; }

/* header */
.top { display: flex; align-items: center; justify-content: space-between; height: 46px; }
h1 { font-size: 20px; font-weight: 600; letter-spacing: 0.02em; margin: 0; }

/* iOS switch */
.switch { position: relative; display: inline-flex; cursor: pointer; }
.switch input { position: absolute; opacity: 0; width: 1px; height: 1px; }
.switch-track {
	width: 51px; height: 31px; border-radius: 16px; background: var(--fill-2);
	position: relative; transition: background-color 0.3s var(--ease);
}
.switch-thumb {
	position: absolute; top: 2px; left: 2px; width: 27px; height: 27px; border-radius: 14px;
	background: #fff; box-shadow: var(--thumb-shadow);
	transition: transform 0.35s var(--spring), width 0.2s var(--ease);
}
.switch:active .switch-thumb { width: 33px; }
.switch input:checked + .switch-track { background: var(--on); }
.switch input:checked + .switch-track .switch-thumb { transform: translateX(20px); }
.switch:active input:checked + .switch-track .switch-thumb { transform: translateX(14px); }
.switch input:focus-visible + .switch-track { outline: 3px solid var(--tint-soft); outline-offset: 2px; }
.switch input:disabled + .switch-track { opacity: 0.5; }
.switch.small .switch-track { width: 46px; height: 28px; }
.switch.small .switch-thumb { width: 24px; height: 24px; }
.switch.small input:checked + .switch-track .switch-thumb { transform: translateX(18px); }

/* off: big button / on: status chips — they swap in the same slot */
.hero-slot { position: relative; height: 62px; }
.power-big, .status {
	position: absolute; inset: 0;
	transition: opacity 0.35s var(--ease), transform 0.5s var(--spring), filter 0.35s var(--ease);
}
.power-big {
	display: flex; align-items: center; gap: 12px; padding: 0 16px; border-radius: 18px; text-align: left;
	background: linear-gradient(135deg, var(--tint), color-mix(in srgb, var(--tint) 70%, #b14bff));
	color: #fff; box-shadow: 0 8px 20px -8px color-mix(in srgb, var(--tint) 80%, transparent);
}
.power-big::after {
	content: ""; position: absolute; inset: 0; border-radius: inherit; pointer-events: none;
	box-shadow: 0 0 0 0 color-mix(in srgb, var(--tint) 45%, transparent);
	animation: pulse 2.4s var(--ease) infinite;
}
@keyframes pulse {
	0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--tint) 45%, transparent); }
	70%, 100% { box-shadow: 0 0 0 12px transparent; }
}
.power-icon { width: 38px; height: 38px; border-radius: 19px; background: rgba(255, 255, 255, 0.2); display: grid; place-items: center; flex: none; }
.power-icon svg { width: 20px; height: 20px; stroke-width: 2.6; }
.power-text { display: flex; flex-direction: column; }
.power-title { font-size: 16px; font-weight: 600; }
.power-sub { font-size: 12px; opacity: 0.85; }
.power-big.busy .power-icon svg { animation: spin 0.9s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }

.status { display: flex; align-items: center; gap: 6px; }
.chip {
	flex: 1; min-width: 0; height: 100%; display: flex; flex-direction: column; justify-content: center; gap: 2px;
	padding: 0 12px; background: var(--card); border-radius: 14px; box-shadow: var(--card-shadow);
	white-space: nowrap; overflow: hidden;
}
.chip-label { font-size: 11px; color: var(--text-2); }
.chip-value { display: flex; align-items: center; gap: 6px; font-size: 14px; font-weight: 500; min-width: 0; overflow: hidden; text-overflow: ellipsis; }
.num { font-variant-numeric: tabular-nums; transition: color 0.3s; }
.dot { width: 9px; height: 9px; border-radius: 50%; background: var(--text-3); flex: none; transition: background-color 0.4s; }
.dot.live { background: var(--on); animation: breathe 2s ease-in-out infinite; }
@keyframes breathe { 50% { opacity: 0.35; transform: scale(0.8); } }
.dot.spinner { background: none; border: 2px solid var(--fill-2); border-top-color: var(--tint); animation: spin 0.8s linear infinite; }
.dot.ok { background: var(--on); }
.dot.mid { background: var(--orange); }
.dot.high { background: var(--red); }

body.is-off .status, body.is-on .power-big { opacity: 0; pointer-events: none; transform: scale(0.92); filter: blur(4px); }
body.is-on .status { opacity: 1; transform: none; filter: none; }
body.is-on .status .chip { animation: chip-in 0.55s var(--spring) both; }
body.is-on .status .chip:nth-child(2) { animation-delay: 0.05s; }
body.is-on .status .chip:nth-child(3) { animation-delay: 0.1s; }
@keyframes chip-in { from { opacity: 0; transform: translateY(8px) scale(0.96); } }

/* cards */
.card { background: var(--card); border-radius: 18px; padding: 12px 14px; box-shadow: var(--card-shadow); }
.label { font-size: 13px; color: var(--text-2); }
.pill-btn {
	font-size: 12px; font-weight: 500; color: var(--tint); background: var(--tint-soft);
	padding: 4px 10px; border-radius: 999px;
}
.pill-btn[hidden] { display: inline-block; visibility: hidden; opacity: 0; transform: scale(0.7); }

.key-head { display: flex; align-items: center; justify-content: space-between; height: 24px; }
.key-row { display: flex; align-items: center; justify-content: space-between; margin: 2px 6px 4px; }
.round-btn { width: 48px; height: 48px; border-radius: 50%; background: var(--fill); display: grid; place-items: center; color: var(--tint); }
.round-btn svg { width: 22px; height: 22px; stroke-width: 2.6; }
.round-btn:disabled { opacity: 0.35; }
.key-display { display: flex; flex-direction: column; align-items: center; }
.key-roller { position: relative; height: 56px; width: 130px; overflow: hidden; }
.key-num {
	position: absolute; inset: 0; text-align: center; font-size: 46px; line-height: 56px; font-weight: 600;
	letter-spacing: -0.01em; font-variant-numeric: tabular-nums;
}
.key-num.enter-up { animation: in-up 0.45s var(--spring) both; }
.key-num.leave-up { animation: out-up 0.3s var(--ease) both; }
.key-num.enter-down { animation: in-down 0.45s var(--spring) both; }
.key-num.leave-down { animation: out-down 0.3s var(--ease) both; }
@keyframes in-up { from { transform: translateY(60%); opacity: 0; filter: blur(3px); } }
@keyframes out-up { to { transform: translateY(-60%); opacity: 0; filter: blur(3px); } }
@keyframes in-down { from { transform: translateY(-60%); opacity: 0; filter: blur(3px); } }
@keyframes out-down { to { transform: translateY(60%); opacity: 0; filter: blur(3px); } }
.key-unit { font-size: 11px; line-height: 14px; color: var(--text-2); margin-top: 2px; transition: color 0.2s; }
.key-unit.pending { color: var(--text-2); animation: breathe-text 1s ease-in-out infinite; }
.key-unit.done { color: var(--on); font-weight: 600; }
@keyframes breathe-text { 50% { opacity: 0.45; } }
.key-num.tick { animation: tick 0.18s var(--ease); }
@keyframes tick { from { transform: translateY(var(--tick-y, 0)) scale(1.08); } }

/* iOS-like slider */
.ios-range {
	--pct: 50%;
	-webkit-appearance: none; appearance: none; width: 100%; height: 30px; margin: 0; background: none; cursor: pointer;
}
.ios-range::-webkit-slider-runnable-track {
	height: 6px; border-radius: 3px;
	background: linear-gradient(to right, var(--tint) var(--pct), var(--fill-2) var(--pct));
}
.ios-range::-webkit-slider-thumb {
	-webkit-appearance: none; width: 28px; height: 28px; margin-top: -11px; border-radius: 50%;
	background: #fff; box-shadow: var(--thumb-shadow);
	transition: transform 0.3s var(--spring);
}
.ios-range:active::-webkit-slider-thumb { transform: scale(1.18); }
.ios-range:focus-visible { outline: none; }
.ios-range:focus-visible::-webkit-slider-thumb { box-shadow: var(--thumb-shadow), 0 0 0 4px var(--tint-soft); }
.ticks { display: flex; justify-content: space-between; font-size: 11px; color: var(--text-2); margin-top: -2px; padding: 0 4px; }

/* A/B */
.ab {
	display: flex; align-items: center; gap: 12px; padding: 10px 14px; border-radius: 18px; text-align: left;
	background: var(--card); box-shadow: var(--card-shadow); position: relative; overflow: hidden;
}
.ab::before {
	content: ""; position: absolute; inset: 0; background: var(--orange); transform: scaleX(0); transform-origin: left;
	transition: transform 0.5s var(--ease); z-index: 0;
}
.ab > * { position: relative; z-index: 1; }
.ab-icon { width: 34px; height: 34px; border-radius: 10px; background: var(--tint-soft); color: var(--tint); display: grid; place-items: center; transition: background-color 0.3s, color 0.3s; }
.ab-icon svg { width: 20px; height: 20px; }
.ab-text { display: flex; flex-direction: column; }
.ab-title { font-size: 15px; font-weight: 500; }
.ab-sub { font-size: 12px; color: var(--text-2); transition: color 0.3s; }
.ab[aria-pressed="true"] { color: #fff; }
.ab[aria-pressed="true"]::before { transform: scaleX(1); }
.ab[aria-pressed="true"] .ab-icon { background: rgba(255, 255, 255, 0.25); color: #fff; }
.ab[aria-pressed="true"] .ab-icon svg { animation: wave 1.2s ease-in-out infinite; }
.ab[aria-pressed="true"] .ab-sub { color: rgba(255, 255, 255, 0.85); }
@keyframes wave { 50% { transform: scaleY(0.6); } }
.ab:disabled { opacity: 0.45; cursor: default; transform: none; }

/* segmented control with sliding thumb */
.mode-card { padding: 10px; }
.segmented { position: relative; display: grid; grid-template-columns: 1fr 1fr; background: var(--fill); border-radius: 10px; padding: 2px; }
.seg-thumb {
	position: absolute; top: 2px; bottom: 2px; left: 2px; width: calc(50% - 2px); border-radius: 8px;
	background: var(--card); box-shadow: 0 3px 8px rgba(0, 0, 0, 0.12), 0 3px 1px rgba(0, 0, 0, 0.04);
	transition: transform 0.45s var(--spring);
}
@media (prefers-color-scheme: dark) { .seg-thumb { background: #636366; } }
.segmented button { position: relative; z-index: 1; height: 32px; font-size: 14px; font-weight: 400; color: var(--text); }
.segmented button[aria-checked="true"] { font-weight: 600; }
.segmented button:active { opacity: 0.6; }
.mode-hint { margin: 8px 4px 2px; font-size: 12px; color: var(--text-2); min-height: 35px; transition: opacity 0.25s; }
.mode-notice {
	display: flex; gap: 6px; align-items: flex-start; margin: 2px 2px 0; padding: 7px 9px; border-radius: 10px;
	background: color-mix(in srgb, var(--orange) 14%, transparent); color: var(--text); font-size: 12px;
	animation: notice-in 0.5s var(--spring) both;
}
.mode-notice[hidden] { display: none; }
.mode-notice svg { width: 15px; height: 15px; flex: none; color: var(--orange); margin-top: 1px; }
.mode-notice.info { background: var(--tint-soft); }
.mode-notice.info svg { color: var(--tint); }
body.has-notice .mode-hint { display: none; }
@keyframes notice-in { from { opacity: 0; transform: translateY(-4px) scale(0.98); } }
.mode-hint.swap { opacity: 0; }

/* settings row */
.row-btn {
	display: flex; align-items: center; gap: 8px; width: 100%; height: 46px; padding: 0 12px 0 16px; border-radius: 14px;
	background: var(--card); box-shadow: var(--card-shadow); font-size: 15px; text-align: left;
}
.row-btn > span:first-child { flex: 1; }
.row-value { color: var(--text-2); font-size: 13px; }
.chev { width: 16px; height: 16px; color: var(--text-3); stroke-width: 2.8; }

/* bottom sheet */
.backdrop {
	position: fixed; inset: 0; z-index: 10; background: rgba(0, 0, 0, 0.35);
	opacity: 0; pointer-events: none; transition: opacity 0.4s var(--ease);
}
.sheet {
	position: fixed; left: 0; right: 0; bottom: 0; z-index: 20; max-height: 576px; display: flex; flex-direction: column;
	background: var(--sheet-bg); border-radius: 16px 16px 0 0; box-shadow: 0 -10px 40px rgba(0, 0, 0, 0.2);
	transform: translateY(105%); transition: transform 0.5s var(--ease);
}
body.sheet-open .backdrop { opacity: 1; pointer-events: auto; }
.sheet.open { transform: translateY(0); }
body.sheet-open .app { transform: scale(0.94); border-radius: 16px; filter: brightness(0.96); }
.app { transition: transform 0.5s var(--ease), filter 0.5s var(--ease); transform-origin: 50% 0; }
.sheet.dragging { transition: none; }
.grabber { display: grid; place-items: center; height: 18px; cursor: grab; touch-action: none; }
.grabber span { width: 36px; height: 5px; border-radius: 3px; background: var(--text-3); }
.sheet-head { display: flex; align-items: center; justify-content: center; position: relative; height: 34px; }
.sheet-head h2 { margin: 0; font-size: 16px; font-weight: 600; }
.done-btn { position: absolute; right: 14px; color: var(--tint); font-weight: 600; font-size: 15px; }
.done-btn:active { opacity: 0.5; }
.sheet-body { overflow-y: auto; padding: 0 16px 14px; scrollbar-width: none; }
.group-title { margin: 12px 4px 6px; font-size: 12px; color: var(--text-2); }
.group { background: var(--card); border-radius: 12px; overflow: hidden; }
.group-row { display: flex; align-items: center; justify-content: space-between; gap: 10px; min-height: 44px; padding: 7px 14px; font-size: 14px; cursor: pointer; }
.group-row.column { flex-direction: column; align-items: stretch; cursor: default; }
.group-row + .group-row { border-top: 0.5px solid var(--sep); }
.group-foot { margin: 6px 4px 0; font-size: 11.5px; color: var(--text-2); }
.formant-head { display: flex; align-items: center; justify-content: space-between; }
.formant-value { font-weight: 500; font-size: 15px; }
.engine-row { width: 100%; text-align: left; }
.engine-row:active { background: var(--fill); }
.check { width: 18px; height: 18px; color: var(--tint); stroke-width: 3; opacity: 0; transform: scale(0.4); transition: opacity 0.2s, transform 0.4s var(--spring); }
.engine-row[aria-checked="true"] .check { opacity: 1; transform: none; }

@media (prefers-reduced-motion: reduce) {
	*, *::before, *::after { animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; transition-duration: 0.01ms !important; }
}

/* ---------- practice tab ---------- */
.card-head { display: flex; align-items: center; justify-content: space-between; min-height: 24px; }
.card-head .value { font-size: 15px; font-weight: 500; font-variant-numeric: tabular-nums; }
.card-head .sub { font-size: 11.5px; color: var(--text-2); }
.vocal-card { position: relative; overflow: hidden; }
.chips-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; margin-top: 2px; }
.choice {
	height: 30px; border-radius: 9px; background: var(--fill); font-size: 12.5px; color: var(--text);
	transition: background-color 0.25s, color 0.25s, transform 0.35s var(--spring);
}
.choice:active { transform: scale(0.94); transition-duration: 0.08s; }
.choice[aria-pressed="true"] { background: var(--tint); color: #fff; }
.locked {
	position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px;
	background: color-mix(in srgb, var(--card) 80%, transparent); backdrop-filter: blur(6px);
	font-size: 12.5px; color: var(--text-2); text-align: center; padding: 0 16px;
	opacity: 0; pointer-events: none; transition: opacity 0.35s var(--ease);
}
.locked b { color: var(--text); font-weight: 500; }
body.mode-light .locked { opacity: 1; pointer-events: auto; }
.pill-btn.strong { background: var(--tint); color: #fff; padding: 5px 12px; }

.range-graph { position: relative; height: 30px; margin: 8px 0 6px; border-radius: 8px; background: var(--fill); overflow: hidden; }
.bar { position: absolute; left: 0; width: 0; border-radius: 6px; transition: left 0.6s var(--spring), width 0.6s var(--spring), opacity 0.3s; }
.bar.song { top: 4px; height: 10px; background: var(--tint); }
.bar.voice { bottom: 4px; height: 10px; background: color-mix(in srgb, var(--on) 25%, transparent); box-shadow: inset 0 0 0 2px var(--on); }
.bar.empty { opacity: 0; }
.bar.song.over { background: linear-gradient(90deg, var(--tint) 70%, var(--red)); }
.range-rows { display: flex; flex-direction: column; gap: 2px; }
.range-row { display: flex; align-items: center; gap: 7px; font-size: 13px; height: 22px; }
.legend { width: 10px; height: 10px; border-radius: 3px; flex: none; }
.legend.song { background: var(--tint); }
.legend.voice { background: color-mix(in srgb, var(--on) 25%, transparent); box-shadow: inset 0 0 0 2px var(--on); }
.who { color: var(--text-2); width: 42px; flex: none; }
.notes { flex: 1; font-variant-numeric: tabular-nums; font-weight: 500; }
.link-btn { color: var(--tint); font-size: 12.5px; padding: 2px 4px; }
.link-btn:active { opacity: 0.5; }
.recommend {
	display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-top: 8px; min-height: 40px;
	padding: 6px 6px 6px 10px; border-radius: 11px; background: var(--card-2); font-size: 12.5px; color: var(--text-2);
}
.recommend.has { background: var(--tint-soft); color: var(--text); }
.rec-text b { font-size: 16px; font-weight: 600; color: var(--tint); margin: 0 2px; }
.recommend .pill-btn[hidden] { display: none; }

.loop-row { display: flex; align-items: center; gap: 6px; margin-top: 6px; }
.loop-btn {
	flex: 1; height: 38px; border-radius: 10px; background: var(--fill); display: flex; align-items: center; justify-content: center; gap: 6px;
	font-size: 13px; font-variant-numeric: tabular-nums; transition: transform 0.35s var(--spring), background-color 0.25s;
}
.loop-btn b { width: 20px; height: 20px; border-radius: 6px; display: grid; place-items: center; font-size: 11px; background: var(--card); color: var(--tint); font-weight: 600; }
.loop-btn:active { transform: scale(0.94); transition-duration: 0.08s; }
.loop-btn.set { background: var(--tint-soft); }
.loop-arrow { width: 16px; height: 16px; color: var(--text-3); flex: none; }
body.loop-on .loop-arrow { color: var(--tint); animation: nudge 1.2s ease-in-out infinite; }
@keyframes nudge { 50% { transform: translateX(3px); } }
.row-btn small { display: block; font-size: 11px; color: var(--text-2); margin-top: -1px; }
.row-btn { height: 50px; flex: none; }

/* ---------- key book sheet ---------- */
.song-row { display: flex; align-items: center; gap: 10px; min-height: 52px; padding: 6px 8px 6px 14px; overflow: hidden; transition: max-height 0.35s var(--ease), opacity 0.3s, padding 0.35s; max-height: 80px; }
.song-row + .song-row { border-top: 0.5px solid var(--sep); }
.song-row.removing { max-height: 0; opacity: 0; padding-top: 0; padding-bottom: 0; }
.song-info { flex: 1; min-width: 0; }
.song-title { font-size: 13.5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.song-meta { font-size: 11px; color: var(--text-2); }
.song-key { font-size: 15px; font-weight: 600; color: var(--tint); font-variant-numeric: tabular-nums; min-width: 34px; text-align: right; }
.song-row.current .song-title::before { content: attr(data-now) " "; color: var(--on); font-size: 11px; }
.empty { font-size: 12.5px; color: var(--text-2); text-align: center; margin: 14px 0; }
.empty[hidden], #songList:empty { display: none; }
kbd { font: 12px/1 ui-monospace, "SF Mono", Consolas, monospace; color: var(--text-2); background: var(--fill); padding: 4px 6px; border-radius: 6px; white-space: nowrap; }
.shortcuts .group-row { cursor: default; gap: 12px; }
.shortcuts .group-row > span { flex: none; }
.shortcuts kbd { min-width: 0; overflow: hidden; text-overflow: ellipsis; }

/* views never squeeze their cards; the practice tab uses slightly tighter cards */
.view > * { flex: none; }
#viewPractice { gap: 8px; }
#viewPractice .card { padding: 10px 12px; }
.recommend .pill-btn { white-space: nowrap; flex: none; }
.rec-text { line-height: 1.35; }

/* a new version is waiting: a dot on the settings button */
.icon-btn { position: relative; }
.icon-btn.has-update::after { content: ''; position: absolute; top: 4px; right: 4px; width: 9px; height: 9px; border-radius: 50%; background: var(--tint); box-shadow: 0 0 0 2px var(--bg); }
