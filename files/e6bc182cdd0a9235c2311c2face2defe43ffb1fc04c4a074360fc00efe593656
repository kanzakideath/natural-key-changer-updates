// Localised strings (extension/_locales). t('key', value) fills $1.
export function t(key, value) {
	const msg = chrome.i18n.getMessage(key, value === undefined ? undefined : [String(value)]);
	return msg || key;
}

// Fill elements marked with data-i18n (text), data-i18n-title and data-i18n-aria.
export function localize(root = document) {
	document.documentElement.lang = chrome.i18n.getUILanguage().startsWith('ja') ? 'ja' : 'en';
	for (const el of root.querySelectorAll('[data-i18n]')) el.textContent = t(el.dataset.i18n);
	for (const el of root.querySelectorAll('[data-i18n-title]')) el.title = t(el.dataset.i18nTitle);
	for (const el of root.querySelectorAll('[data-i18n-aria]')) el.setAttribute('aria-label', t(el.dataset.i18nAria));
}

export const isJapanese = () => chrome.i18n.getUILanguage().startsWith('ja');
