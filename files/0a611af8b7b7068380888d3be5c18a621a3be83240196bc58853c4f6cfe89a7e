.hero { flex-direction: column; text-align: center; gap: 6px; padding: 8px 0 4px; }
.hero img { animation: pop 0.8s var(--spring) both; border-radius: 22px; }
.hero h1 { font-size: 32px; animation: rise 0.6s 0.1s var(--ease) both; }
.hero .lead { font-size: 15px; max-width: 46ch; margin: 0 auto; animation: rise 0.6s 0.18s var(--ease) both; }
.steps-cards { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 12px; }
.step { display: flex; align-items: flex-start; gap: 14px; animation: rise 0.6s var(--ease) both; }
.step:nth-child(1) { animation-delay: 0.25s; }
.step:nth-child(2) { animation-delay: 0.33s; }
.step:nth-child(3) { animation-delay: 0.41s; }
.step h2 { margin: 0 0 2px; color: var(--text); font-size: 16px; }
.step p { margin: 0; color: var(--text-2); font-size: 14px; }
.step > div { flex: 1; }
.num { flex: none; width: 30px; height: 30px; border-radius: 15px; display: grid; place-items: center; background: var(--tint); color: #fff; font-weight: 600; font-size: 15px; }
.step-icon { flex: none; width: 26px; height: 26px; color: var(--tint); opacity: 0.85; }
.practice { animation: rise 0.6s 0.5s var(--ease) both; }
.practice h2 { color: var(--text); font-size: 17px; margin-bottom: 6px; }
.practice p { margin: 0 0 14px; color: var(--text-2); font-size: 14px; }
a.btn { text-decoration: none; }
.privacy { display: flex; align-items: center; gap: 8px; justify-content: center; color: var(--text-2); font-size: 13px; margin: 4px 0 0; animation: rise 0.6s 0.6s var(--ease) both; }
.privacy svg { width: 16px; height: 16px; }
@keyframes pop { from { transform: scale(0.6); opacity: 0; } }
@keyframes rise { from { transform: translateY(12px); opacity: 0; } }
