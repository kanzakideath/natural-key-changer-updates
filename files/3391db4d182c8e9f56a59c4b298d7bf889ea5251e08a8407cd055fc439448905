:root { --bg: #f2f2f7; --card: #fff; --text: #000; --text2: rgba(60,60,67,.62); --sep: rgba(60,60,67,.16); --tint: #5856d6; --on: #34c759; --red: #ff3b30; --orange: #ff9500; color-scheme: light dark; }
@media (prefers-color-scheme: dark) { :root { --bg: #000; --card: #1c1c1e; --text: #fff; --text2: rgba(235,235,245,.6); --sep: rgba(84,84,88,.5); --tint: #7d7aff; } }
* { box-sizing: border-box; }
body { margin: 0; background: var(--bg); color: var(--text); font: 15px/1.5 -apple-system, "Hiragino Sans", "Noto Sans JP", "Yu Gothic UI", system-ui, sans-serif; }
main { max-width: 640px; margin: 0 auto; padding: 32px 16px 56px; }
header { display: flex; align-items: center; gap: 16px; margin-bottom: 22px; }
header img { border-radius: 14px; }
h1 { margin: 0; font-size: 26px; letter-spacing: -.01em; }
h2 { margin: 0 0 6px; font-size: 17px; }
header p { margin: 2px 0 0; color: var(--text2); }
.card { background: var(--card); border-radius: 16px; padding: 18px 18px 16px; margin-bottom: 14px; animation: rise .5s cubic-bezier(.22,1.1,.36,1) both; }
.card:nth-of-type(2) { animation-delay: .06s; } .card:nth-of-type(3) { animation-delay: .12s; }
@keyframes rise { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
.state { font-size: 19px; font-weight: 650; display: flex; align-items: center; gap: 10px; }
.state::before { content: ''; width: 12px; height: 12px; border-radius: 50%; background: var(--on); box-shadow: 0 0 0 4px rgba(52,199,89,.2); flex: none; }
.state.new::before { background: var(--tint); box-shadow: 0 0 0 4px rgba(88,86,214,.22); animation: pulse 1.6s ease-in-out infinite; }
.state.warn::before { background: var(--orange); box-shadow: 0 0 0 4px rgba(255,149,0,.2); }
.state.bad::before { background: var(--red); box-shadow: 0 0 0 4px rgba(255,59,48,.18); }
@keyframes pulse { 50% { box-shadow: 0 0 0 8px rgba(88,86,214,.08); } }
.notes { margin: 8px 0 0; color: var(--text2); white-space: pre-wrap; }
.notes:empty { display: none; }
.actions, .row { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; margin-top: 14px; }
.row.between { justify-content: space-between; flex-wrap: nowrap; margin: 0; }
.btn { appearance: none; border: 0; border-radius: 12px; padding: 10px 18px; font: 600 15px/1 inherit; cursor: pointer; background: rgba(118,118,128,.14); color: var(--text); transition: transform .16s cubic-bezier(.22,1.18,.36,1), background .2s; }
.btn:active { transform: scale(.95); }
.btn:disabled { opacity: .45; pointer-events: none; }
.btn.primary { background: var(--tint); color: #fff; }
.btn[hidden] { display: none; }
.folder { color: var(--text2); font-size: 14px; word-break: break-all; }
.folder.ok { color: var(--on); font-weight: 600; }
.hint, small { color: var(--text2); font-size: 13px; }
.hint { margin: 10px 0 0; }
.msg { margin: 12px 0 0; min-height: 1.4em; color: var(--text2); font-size: 14px; white-space: pre-wrap; }
.msg.bad { color: var(--red); }
.msg.ok { color: var(--on); }
.bar { height: 6px; border-radius: 3px; background: rgba(118,118,128,.18); overflow: hidden; margin-top: 14px; }
.bar i { display: block; height: 100%; width: 0; background: var(--tint); border-radius: 3px; transition: width .25s ease; }
.switch { position: relative; width: 51px; height: 31px; flex: none; }
.switch input { position: absolute; inset: 0; opacity: 0; margin: 0; cursor: pointer; z-index: 1; }
.track { position: absolute; inset: 0; border-radius: 16px; background: rgba(118,118,128,.3); transition: background .25s; }
.thumb { position: absolute; top: 2px; left: 2px; width: 27px; height: 27px; border-radius: 50%; background: #fff; box-shadow: 0 3px 8px rgba(0,0,0,.18); transition: transform .3s cubic-bezier(.34,1.56,.64,1); }
.switch input:checked + .track { background: var(--on); }
.switch input:checked + .track .thumb { transform: translateX(20px); }
.foot { color: var(--text2); font-size: 12px; text-align: center; margin-top: 22px; }
@media (prefers-reduced-motion: reduce) { .card, .state.new::before { animation: none; } }
