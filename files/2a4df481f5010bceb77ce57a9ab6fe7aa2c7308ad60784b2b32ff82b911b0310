// Lyrics ↔ audio alignment.
//
// The lyrics give the times lines start in the original recording. What is playing may be
// another version of the song: a music video with a longer intro, a cover in another tempo, a
// live take, a version with a verse cut or an extra solo. From the singing activity of the
// separated vocals (and, when available, recognised words) this finds the offset between the
// lyrics and the playing audio, as it changes through the song:
//
//   - expected singing E(l): from each line's start, for roughly as long as it takes to sing it
//   - observed singing O(m): fraction of voiced frames of the vocals, in 0.1 s bins
//   - for every 1 s step, a score for each candidate offset (agreement of O(m) with E(m+o)
//     over an 8 s window), computed for all offsets at once with prefix sums
//   - Viterbi over (step, offset): keeping the offset is free, drifting by 0.1 s (tempo) is
//     cheap, jumping (a cut, an insert, an intro) is expensive; a small prior favours "no
//     offset", so official recordings are left alone
//
// Output: anchors for KCL.TimeMap (media -> lyrics), and a confidence.
(function (root) {
	const KCL = (root.KCL = root.KCL || {});
	const BIN = 0.1; // s
	const RANGE = 45; // max |offset| in s
	const NOFF = Math.round((2 * RANGE) / BIN) + 1;
	const WIN = 80; // bins (8 s)
	const STEP = 10; // bins (1 s)

	// roughly how long a line takes to sing (seconds), from its text
	function singDuration(text) {
		let cjk = 0, other = 0;
		for (const ch of text) {
			if (/[぀-ヿ㐀-鿿가-힯]/.test(ch)) cjk++;
			else if (/[a-z0-9À-ɏ]/i.test(ch)) other++;
		}
		return Math.min(8, Math.max(0.8, cjk * 0.26 + other * 0.068));
	}

	class Aligner {
		constructor(lines) {
			this.lines = lines.filter((l) => l.t != null && l.text);
			const endL = this.lines.length ? this.lines[this.lines.length - 1].t + 12 : 0;
			// expected activity, -1..1 (singing = +1), on the lyrics timeline from -RANGE
			this.eBase = -RANGE;
			const n = Math.ceil((endL - this.eBase + 2 * RANGE) / BIN) + 1;
			this.E = new Float32Array(n).fill(-1);
			for (let i = 0; i < this.lines.length; ++i) {
				const l = this.lines[i];
				const next = i + 1 < this.lines.length ? this.lines[i + 1].t : l.t + 10;
				const dur = Math.min(Math.max(singDuration(l.text) * 1.6, 2.5), 9, Math.max(0.5, next - l.t - 0.25));
				const a = Math.round((l.t - this.eBase) / BIN), b = Math.round((l.t + dur - this.eBase) / BIN);
				for (let k = Math.max(0, a); k < Math.min(n, b); ++k) this.E[k] = 1;
			}
			// observations: segments of contiguous media time (a seek starts a new one)
			this.segs = []; // {m0, v: number[]}
			this.anchorsExt = []; // {m, l, w} from word recognition
		}

		// voiced fraction (0..1) for consecutive 0.1 s bins starting at media time m0
		add(m0, values) {
			let seg = this.segs[this.segs.length - 1];
			const k0 = Math.round(m0 / BIN);
			if (!seg || Math.abs(k0 - (seg.k0 + seg.v.length)) > 2) {
				seg = { k0, v: [] };
				this.segs.push(seg);
			}
			const at = k0 - seg.k0;
			for (let i = 0; i < values.length; ++i) seg.v[at + i] = values[i];
			for (let i = 0; i < seg.v.length; ++i) if (seg.v[i] == null) seg.v[i] = 0;
		}

		addAnchor(m, l, w = 1) {
			this.anchorsExt.push({ m, l, w });
		}

		// How much singing has been observed (s): the alignment needs a few lines to be sure.
		get voicedSeconds() {
			let s = 0;
			for (const seg of this.segs) for (const x of seg.v) s += x * BIN;
			return s;
		}

		// emission scores for one window at one tempo (cached: past windows never change)
		stepScores(seg, c, tempo, gain, win) {
			const key = `${seg.k0}:${c}:${tempo}`;
			const cached = this.cache.get(key);
			if (cached && cached.len === Math.min(seg.v.length, c + win / 2)) return cached.sc;
			const half = (NOFF - 1) / 2;
			const eOff = -this.eBase / BIN;
			const len = seg.v.length;
			const a = Math.max(0, c - win / 2), b = Math.min(len, c + win / 2);
			const n = b - a;
			let so = 0, soo = 0;
			const O = new Float32Array(n);
			for (let i = a; i < b; ++i) { const x = Math.min(1, seg.v[i] * 1.6); O[i - a] = x; so += x; soo += x * x; }
			const mo = so / n, vo = soo / n - mo * mo;
			const sc = new Float32Array(NOFF);
			// a window that is all singing or all silence says nothing about the offset
			if (vo > 0.02) {
				const sdo = Math.sqrt(vo);
				// media bin (seg.k0 + i) at tempo s maps to lyrics bin round((seg.k0 + i) * s) + o
				const lb = new Int32Array(n);
				for (let i = 0; i < n; ++i) lb[i] = Math.round((seg.k0 + a + i) * tempo + eOff);
				for (let j = 0; j < NOFF; ++j) {
					const o = j - half;
					let se = 0, soe = 0;
					for (let i = 0; i < n; ++i) {
						if (this.E[lb[i] + o] > 0) { se++; soe += O[i]; }
					}
					const me = se / n, ve = me - me * me;
					sc[j] = ve > 0.01 ? (gain * (soe / n - mo * me)) / (sdo * Math.sqrt(ve)) : 0;
				}
			}
			this.cache.set(key, { len: b, sc });
			return sc;
		}

		// tempos: lyrics seconds per media second to try (a cover may be a little faster/slower)
		solve({ jump = 25, drift = 0.8, prior = 12, gain = 2, win = 120, tempos = [1, 0.97, 1.03, 0.94, 1.06], tempoCost = 3, hints = [], asrGain = 3 } = {}) {
			if (!this.cache) this.cache = new Map();
			let best = null;
			for (const tempo of tempos) {
				const r = this.solveTempo(tempo, { jump, drift, prior, gain, win, hints, asrGain });
				if (!r) return null;
				r.score -= tempo === 1 ? 0 : tempoCost * (1 + Math.abs(tempo - 1) * 20);
				if (!best || r.score > best.score) best = r;
			}
			return best;
		}

		// hints: offsets (s) that are as likely as none at the start (e.g. the video is longer than
	// the recording the lyrics belong to: a longer intro)
	solveTempo(tempo, { jump, drift, prior, gain, win, hints = [], asrGain = 3 }) {
			const steps = [];
			const half = (NOFF - 1) / 2;
			for (const seg of this.segs) {
				const len = seg.v.length;
				if (len < 40) continue;
				const first = Math.min(win / 2, len);
				for (let c = first; c <= len; c += STEP) {
					const sc = Float32Array.from(this.stepScores(seg, c, tempo, gain, win));
					// media time m -> lyrics time m * tempo + offset
					steps.push({ m: (seg.k0 + c) * BIN, sc, newSeg: c === first });
				}
			}
			if (!steps.length) return null;
			// recognised words: a bonus around their offset
			for (const an of this.anchorsExt) {
				let st = null;
				for (const x of steps) if (!st || Math.abs(x.m - an.m) < Math.abs(st.m - an.m)) st = x;
				if (!st || Math.abs(st.m - an.m) > 4) continue;
				const jo = Math.round((an.l - an.m * tempo) / BIN) + half;
				for (let d = -4; d <= 4; ++d) if (jo + d >= 0 && jo + d < NOFF) st.sc[jo + d] += an.w * gain * asrGain * (1 - Math.abs(d) / 5);
			}
			// Viterbi over offsets
			const zero = half;
			let V = new Float32Array(NOFF);
			const back = [];
			const hinted = new Set(hints.map((h) => Math.round(h / BIN) + zero).filter((j) => j >= 0 && j < NOFF));
			for (let j = 0; j < NOFF; ++j) {
				let near = j === zero ? 0 : prior;
				for (const h of hinted) near = Math.min(near, Math.abs(j - h) <= 2 ? prior * 0.15 : prior);
				V[j] = steps[0].sc[j] - near;
			}
			for (let t = 1; t < steps.length; ++t) {
				const sc = steps[t].sc;
				const jp = steps[t].newSeg ? jump * 0.3 : jump;
				let bestJ = 0;
				for (let j = 1; j < NOFF; ++j) if (V[j] > V[bestJ]) bestJ = j;
				const W = new Float32Array(NOFF);
				const bk = new Int16Array(NOFF);
				for (let j = 0; j < NOFF; ++j) {
					let v = V[j], from = j;
					if (j > 0 && V[j - 1] - drift > v) { v = V[j - 1] - drift; from = j - 1; }
					if (j + 1 < NOFF && V[j + 1] - drift > v) { v = V[j + 1] - drift; from = j + 1; }
					if (V[bestJ] - jp > v) { v = V[bestJ] - jp; from = bestJ; }
					W[j] = v + sc[j];
					bk[j] = from;
				}
				back.push(bk);
				V = W;
			}
			let end = 0;
			for (let j = 1; j < NOFF; ++j) if (V[j] > V[end]) end = j;
			const path = new Int16Array(steps.length);
			path[steps.length - 1] = end;
			for (let t = steps.length - 1; t > 0; --t) path[t - 1] = back[t - 1][path[t]];
			const offsets = Array.from(path, (j) => (j - zero) * BIN);
			// confidence: the best path against "the lyrics are right as they are" (offset 0 all
			// along, no jumps)
			let stay = -0;
			for (const st of steps) stay += st.sc[zero];
			return { tempo, score: V[end], margin: V[end] - stay, steps: steps.map((s, i) => ({ m: s.m, l: s.m * tempo + offsets[i] })), offset: offsets[offsets.length - 1] };
		}

		// anchors (media -> lyrics) from a solution: one per change of offset
		static anchors(sol) {
			if (!sol) return [];
			// one anchor per step, made monotonic: where the lyrics would go back (an inserted
			// part), they hold instead
			const out = [];
			const first = sol.steps[0];
			out.push({ m: first.m - 60, l: first.l - 60 * (sol.tempo || 1) });
			for (const s of sol.steps) {
				const last = out[out.length - 1];
				out.push({ m: s.m, l: Math.max(last.l, s.l) });
			}
			return out;
		}
	}

	KCL.Aligner = Aligner;
	KCL.singDuration = singDuration;
	KCL.ALIGN_BIN = BIN;
})(globalThis);
